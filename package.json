{
  "name": "witty-word-plugin",
  "scripts": {
    "build": "ng build --configuration production --base-href=/",
    "build:test": "ng build --configuration test",
    "build:dev": "ng build",
    "dev-server": "bash -c \"ng serve --ssl --ssl-key ~/.office-addin-dev-certs/localhost.key --ssl-cert ~/.office-addin-dev-certs/localhost.crt\"",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "ng": "ng",
    "ssl:config": "office-addin-dev-certs install",
    "start:desktop": "office-addin-debugging start ./src/manifest.xml desktop",
    "start:desktop:prod": "office-addin-debugging start ./src/manifest-prod.xml desktop",
    "start:web": "office-addin-debugging start ./src/manifest.xml web",
    "start:web:prod": "office-addin-debugging start ./src/manifest-prod.xml web",
    "stop": "office-addin-debugging stop ./src/manifest.xml",
    "stop:prod": "office-addin-debugging stop ./src/manifest-prod.xml",
    "test": "ng test",
    "test:coverage": "ng test --watch false --code-coverage",
    "validate": "office-addin-manifest validate ./src/manifest.xml",
    "validate:prod": "office-addin-manifest validate ./src/manifest-prod.xml"
  },
  "license": "proprietary",
  "config": {
    "app-to-debug": "word",
    "app-type-to-debug": "desktop",
    "dev-server-port": 4200
  },
  "dependencies": {
    "@angular/animations": "^21.2.19",
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/platform-browser": "^21.2.19",
    "@angular/platform-browser-dynamic": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@iharbeck/ngx-virtual-scroller": "^17.0.2",
    "@ngneat/dialog": "^5.2.0",
    "@sentry/angular": "^10.69.0",
    "@sentry/cli": "^2.58.2",
    "core-js": "^3.47.0",
    "diff": "^7.0.0",
    "ngx-spinner": "^17.0.0",
    "posthog-js-lite": "^3.6.0",
    "rxjs": "~7.8.0",
    "sentence-splitter": "^5.0.0",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.19",
    "@angular-eslint/builder": "^20.7.0",
    "@angular-eslint/eslint-plugin": "^20.7.0",
    "@angular-eslint/eslint-plugin-template": "^20.7.0",
    "@angular-eslint/schematics": "^20.7.0",
    "@angular-eslint/template-parser": "^20.7.0",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.19",
    "@eslint/js": "^9.39.5",
    "@types/diff": "^7.0.2",
    "@types/jasmine": "^5.1.4",
    "@types/node": "^20.19.25",
    "@types/office-js": "^1.0.560",
    "@types/office-runtime": "^1.0.35",
    "eslint": "^9.39.0",
    "jasmine-core": "^5.4.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "office-addin-debugging": "^5.1.6",
    "office-addin-dev-certs": "^1.13.5",
    "office-addin-manifest": "^1.13.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
