{
  "name": "witty-word-plugin",
  "scripts": {
    "build": "ng build --configuration production --base-href=/",
    "build:test": "ng build --configuration test",
    "build:dev": "ng build",
    "dev-server": "bash -c \"ng serve --ssl --ssl-key ~/.office-addin-dev-certs/localhost.key --ssl-cert ~/.office-addin-dev-certs/localhost.crt\"",
    "e2e": "ng e2e",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "ng": "ng",
    "ssl:config": "office-addin-dev-certs install",
    "start:desktop": "office-addin-debugging start ./src/manifest.xml desktop",
    "start:desktop:prod": "office-addin-debugging start ./src/manifest-prod.xml desktop",
    "start:web": "office-addin-debugging start ./src/manifest.xml web",
    "start:web:prod": "office-addin-debugging start ./src/manifest-prod.xml web",
    "stop": "office-addin-debugging stop ./src/manifest.xml",
    "stop:prod": "office-addin-debugging stop ./src/manifest-prod.xml",
    "test": "ng test",
    "test:coverage": "ng test --watch false --code-coverage",
    "validate": "office-addin-manifest validate ./src/manifest.xml",
    "validate:prod": "office-addin-manifest validate ./src/manifest-prod.xml"
  },
  "license": "proprietary",
  "config": {
    "app-to-debug": "word",
    "app-type-to-debug": "desktop",
    "dev-server-port": 4200
  },
  "dependencies": {
    "@angular/animations": "^15.2.2",
    "@angular/common": "^15.2.2",
    "@angular/compiler": "^15.2.2",
    "@angular/core": "^15.2.2",
    "@angular/forms": "^15.2.9",
    "@angular/platform-browser": "^15.2.2",
    "@angular/platform-browser-dynamic": "^15.2.9",
    "@angular/router": "^15.2.9",
    "@iharbeck/ngx-virtual-scroller": "^15.2.0",
    "@independer/ng-modal": "^2.0.0",
    "@microsoft/office-js-helpers": "^1.0.2",
    "@sentry/angular-ivy": "^7.70.0",
    "@sentry/cli": "^2.20.7",
    "core-js": "^3.32.2",
    "ngx-spinner": "^15.0.1",
    "office-ui-fabric-js": "^1.5.0",
    "posthog-js-lite": "^2.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.2",
    "zone.js": "^0.13.3"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.1502.4",
    "@angular-devkit/build-angular": "^15.2.9",
    "@angular-eslint/builder": "15.2.1",
    "@angular-eslint/eslint-plugin": "15.2.1",
    "@angular-eslint/eslint-plugin-template": "15.2.1",
    "@angular-eslint/schematics": "15.2.1",
    "@angular-eslint/template-parser": "15.2.1",
    "@angular/cli": "^15.2.9",
    "@angular/compiler-cli": "^15.2.9",
    "@types/jasmine": "^4.3.6",
    "@types/node": "^18.17.18",
    "@types/office-js": "^1.0.343",
    "@types/office-runtime": "^1.0.33",
    "@typescript-eslint/eslint-plugin": "5.55.0",
    "@typescript-eslint/parser": "5.55.0",
    "eslint": "^8.49.0",
    "eslint-config-office-addins": "^1.6.7",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-jsdoc": "40.0.3",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "jasmine-core": "4.6.0",
    "jasmine-spec-reporter": "7.0.0",
    "karma": "~6.4.1",
    "karma-chrome-launcher": "~3.1.1",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "office-addin-debugging": "^5.0.12",
    "office-addin-dev-certs": "^1.11.6",
    "office-addin-manifest": "^1.12.7",
    "protractor": "~7.0.0",
    "ts-node": "~10.9.1",
    "typescript": "~4.9.5"
  }
}